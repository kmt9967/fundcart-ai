# Copy to .env.local and fill in. Never commit real values.
# PayPal Sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional: webhook id from the sandbox app (enables verified webhooks)
PAYPAL_WEBHOOK_ID=
# Sandbox accounts that receive contributions (campaign creator) and the purchase (demo store).
# Leave empty to send both to the app's default sandbox business account.
PAYPAL_CONTRIBUTION_PAYEE_EMAIL=
PAYPAL_STORE_PAYEE_EMAIL=

# Channel3 product search (trychannel3.com → Dashboard → API Keys)
CHANNEL3_API_KEY=

# Google AI Studio (Gemini) — optional; without it FundCart uses rule-based fallbacks
GEMINI_API_KEY=
# Comma-separated, tried in order (falls through on 429/5xx/404/timeouts)
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Supabase (Project Settings → API Keys). Secret key is server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Random strings (e.g. `openssl rand -base64 32`)
SESSION_SECRET=
CRON_SECRET=
