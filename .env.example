# Copy to .env.local and fill in. Never commit real values.
# PayPal Sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional: webhook id from the sandbox app (enables verified webhooks)
PAYPAL_WEBHOOK_ID=
# Sandbox accounts that receive contributions (campaign creator) and the purchase (demo store).
# Leave empty to send both to the app's default sandbox business account.
PAYPAL_CONTRIBUTION_PAYEE_EMAIL=
PAYPAL_STORE_PAYEE_EMAIL=

# Channel3 product search (trychannel3.com → Dashboard → API Keys)
CHANNEL3_API_KEY=

# Google AI Studio (Gemini) — optional; without a usable key FundCart uses its rule-based fallback.
# Production project key: used ONLY by the Vercel production deployment (VERCEL_ENV=production).
GEMINI_API_KEY=
# Development/test project key (a DIFFERENT Google AI project): used by local dev, tests, scenario and
# workbook runs, and Vercel preview deployments, so testing never drains the production quota.
GEMINI_API_KEY_DEV=
# Stable model IDs, tried in order ("-latest" aliases are rejected: they change model and limits silently).
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Thinking depth for intent extraction and explanations: minimal | low | medium | high | off
GEMINI_THINKING_LEVEL=minimal
# Set to 1 only for a deliberate, bounded check that must use the production key outside production.
GEMINI_ALLOW_PROD_KEY=

# Supabase (Project Settings → API Keys). Secret key is server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Random strings (e.g. `openssl rand -base64 32`)
SESSION_SECRET=
CRON_SECRET=
